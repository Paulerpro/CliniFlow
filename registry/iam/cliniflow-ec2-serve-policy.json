{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAdapterOnly",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::cliniflow-adapters-paul-2026"
    },
    {
      "Sid": "ReadAdapterObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cliniflow-adapters-paul-2026/adapters/*"
    }
  ]
}
